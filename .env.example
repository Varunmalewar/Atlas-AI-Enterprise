# AWS CONFIGURATION
AWS_ACCESS_KEY_ID="<your_aws_access_key_id>"
AWS_SECRET_ACCESS_KEY="<your_aws_secret_access_key>"
AWS_DEFAULT_REGION="ap-southeast-2"
S3_BUCKET="<your_s3_bucket_name>"

# BEDROCK CONFIGURATION
BEDROCK_EMBED_MODEL="amazon.titan-embed-text-v2:0"
BEDROCK_CHAT_MODEL="amazon.nova-lite-v1:0"
EMBED_DIMENSION=1024

# PINECONE CONFIGURATION
PINECONE_API_KEY="<your_pinecone_api_key>"
PINECONE_INDEX_HOST="<your_pinecone_index_host>"
PINECONE_CLOUD="aws"
PINECONE_REGION="ap-southeast-2"
PINECONE_READY_TIMEOUT=180

# POSTGRESQL DATABASE URL
DATABASE_URL="postgresql://<username>:<password>@<host>:<port>/<database>?sslmode=require"

# RIUS CONFIGURATION OBSERVABILITY
RIUS_API_KEY="<your_rius_api_key>"
RIUS_SERVICE_NAME="atlas-enterprise-ai"
RIUS_DISABLED=false
RIUS_CAPTURE_ENABLED=false